generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique @db.VarChar(100)
  name          String   @db.VarChar(100)
  gender        String   @db.VarChar(10)
  birth         DateTime @db.Date
  address       String   @db.VarChar(255)
  detailAddress String?  @map("detail_address") @db.VarChar(255)
  phoneNumber   String   @map("phone_number") @db.VarChar(20)

  reviews             Review[]
  userMissions        UserMission[]
  userFavorCategories UserFavorCategory[]

  @@map("user")
}

model Store {
  id        Int      @id @default(autoincrement())
  name      String?  @db.VarChar(100)
  address   String?  @db.VarChar(255)
  storeType String?  @map("store_type") @db.VarChar(15)
  status    Boolean  @db.TinyInt
  star      Float
  createAt  DateTime @default(now()) @map("create_at") @db.DateTime(6)
  updateAt  DateTime @updatedAt @map("update_at") @db.DateTime(6)

  reviews      Review[]
  missions     Mission[]
  userMissions UserMission[]

  owner     Owner?   @relation("StoreToOwner")

  @@map("store")
}

model Review {
  id       Int      @id @default(autoincrement())
  userId   Int      @map("user_id")
  storeId  Int      @map("store_id")
  name     String?  @db.VarChar(100)
  content  String?  @db.Text
  image    String?  @db.Text
  star     Float
  createAt DateTime @default(now()) @map("create_at") @db.DateTime(6)
  updateAt DateTime @updatedAt @map("update_at") @db.DateTime(6)

  user  User  @relation(fields: [userId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@map("review")
}

model Mission {
  id            Int      @id @default(autoincrement())
  storeId       Int      @map("store_id")
  point         Int
  deadline      String?  @db.VarChar(5)
  missionDetail String?  @map("mission_detail") @db.Text
  createAt      DateTime @default(now()) @map("create_at") @db.DateTime(6)
  updateAt      DateTime @updatedAt @map("update_at") @db.DateTime(6)

  store        Store         @relation(fields: [storeId], references: [id])
  userMissions UserMission[]

  @@map("mission")
}

model Owner {
  id       Int      @id @default(autoincrement())
  number   Int      @unique
  store_id Int      @unique // storeId -> store_id로 변경
  createAt DateTime @default(now()) @map("create_at") @db.DateTime(6)
  updateAt DateTime @updatedAt @map("update_at") @db.DateTime(6)

  store        Store?         @relation("StoreToOwner", fields: [store_id], references: [id], map: "fk_owner_storeId") 
  userMissions UserMission[] @relation("OwnerNumber")

  @@map("owner")
}

model UserMission {
  id          Int      @id @default(autoincrement())
  missionId   Int      @map("mission_id")
  userId      Int      @map("user_id")
  storeId     Int      @map("store_id")
  ownerNumber Int      @map("owner_number")
  status      Boolean  @db.TinyInt
  createAt    DateTime @default(now()) @map("create_at") @db.DateTime(6)
  updateAt    DateTime @updatedAt @map("update_at") @db.DateTime(6)

  mission Mission @relation(fields: [missionId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])
  owner   Owner   @relation("OwnerNumber", fields: [ownerNumber], references: [number])

  @@map("user_mission")
}

model FoodCategory {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(100)

  userFavorCategories UserFavorCategory[]

  @@map("food_category")
}

model UserFavorCategory {
  id             Int @id @default(autoincrement())
  foodCategoryId Int @map("food_category_id")
  userId         Int @map("user_id")

  foodCategory FoodCategory @relation(fields: [foodCategoryId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@map("user_favor_category")
}
